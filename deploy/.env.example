# Copy to deploy/.env (never commit .env). Docker Compose loads .env from this folder automatically.
#
# === Обязательно для docker compose (stack + auth) ===
# Сгенерируйте случайные значения (openssl rand -hex 24).
POSTGRES_PASSWORD=
JWT_SECRET=

# === Обязательно для docker compose с MinIO (docker-compose.infra.yml) ===
MINIO_ROOT_PASSWORD=

# === Прод: публичные URL (для OAuth redirect и CORS) ===
# FRONTEND_URL=https://app.example.com
# BASE_URL=https://api.example.com
# Несколько фронтов для CORS (через запятую). Если пусто — берётся только FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Фронт в Docker (профиль frontend):
#   cd deploy && docker compose --profile frontend up -d --build
# Браузер ходит на API по localhost:8080; контейнер фронта — на api-gateway по сети compose.
# При другом хосте/порте шлюза задайте NEXT_PUBLIC_API_URL при сборке:
#   NEXT_PUBLIC_API_URL=https://api.example.com docker compose --profile frontend build
#
# Если порт 3000 занят (например, локальный `npm run dev`), задайте другой порт и тот же URL для OAuth/писем:
# FRONTEND_PORT=3001
# FRONTEND_URL=http://localhost:3001
# Google Cloud Console → APIs & Credentials → OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must include exactly:
#   {BASE_URL}/api/v1/auth/google/callback
# (по умолчанию BASE_URL=http://localhost:8080)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — VK ID
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# api-gateway: каталог для загруженных фото (локально по умолчанию ./data/uploads).
# UPLOAD_ROOT=./data/uploads

# venue-service: уведомления в Telegram о новых заявках на модерацию и смене статуса.
# TELEGRAM_BOT_TOKEN=...   # токен от @BotFather
# TELEGRAM_CHAT_ID=...      # число: личный чат или группа (часто отрицательный id для групп)
#
# Как узнать chat_id:
# 1) Личные сообщения: напишите боту любое сообщение, затем откройте в браузере
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    в ответе найдите "chat":{"id": 123456789, ...} — это TELEGRAM_CHAT_ID.
# 2) Группа: добавьте бота в группу, напишите в чат команду /start или упомяните бота,
#    снова вызовите getUpdates — id группы обычно отрицательный (например -1001234567890).
# Без токена и chat_id уведомления отключены (в логах venue-service будет предупреждение).

# api-gateway: письма при приостановке и возобновлении заведения (владелец + venue_staff). Нужны все пять переменных.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USER=your@yandex.ru
# SMTP_PASSWORD=app-password
# SMTP_FROM=your@yandex.ru

# booking-service: IANA-зона для date + time_to (переход confirmed → completed после окончания слота).
# BOOKING_VISIT_TIMEZONE=Europe/Moscow

# === docker-compose.observability.yml (Grafana) ===
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
