# Copy to deploy/.env and fill in (never commit .env).
# Google Cloud Console → APIs & Credentials → OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must include exactly:
#   http://localhost:8080/api/v1/auth/google/callback
# (BASE_URL in docker-compose; change if you use another host/port.)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — VK ID
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# api-gateway: каталог для загруженных фото (локально по умолчанию ./data/uploads).
# UPLOAD_ROOT=./data/uploads

# venue-service: уведомления в Telegram о новых заявках на модерацию и смене статуса.
# TELEGRAM_BOT_TOKEN=...   # токен от @BotFather
# TELEGRAM_CHAT_ID=...      # число: личный чат или группа (часто отрицательный id для групп)
#
# Как узнать chat_id:
# 1) Личные сообщения: напишите боту любое сообщение, затем откройте в браузере
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    в ответе найдите "chat":{"id": 123456789, ...} — это TELEGRAM_CHAT_ID.
# 2) Группа: добавьте бота в группу, напишите в чат команду /start или упомяните бота,
#    снова вызовите getUpdates — id группы обычно отрицательный (например -1001234567890).
# Без токена и chat_id уведомления отключены (в логах venue-service будет предупреждение).

# booking-service: IANA-зона для date + time_to (переход confirmed → completed после окончания слота).
# BOOKING_VISIT_TIMEZONE=Europe/Moscow
