# Copy to deploy/.env (never commit .env). Docker Compose loads .env from this folder automatically.
#
# === Обязательно для docker compose (stack + auth) ===
# Сгенерируйте случайные значения (openssl rand -hex 24).
POSTGRES_PASSWORD=
JWT_SECRET=

# === Обязательно для docker compose с MinIO (docker-compose.infra.yml) ===
MINIO_ROOT_PASSWORD=

# === Прод: публичные URL (для OAuth redirect и CORS) ===
# FRONTEND_URL=https://app.example.com
# BASE_URL=https://api.example.com
# Несколько фронтов для CORS (через запятую). Если пусто — берётся только FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Фронт в Docker (профиль frontend):
#   cd deploy && docker compose --profile frontend up -d --build
# Браузер ходит на API по localhost:8080; контейнер фронта — на api-gateway по сети compose.
# При другом хосте/порте шлюза задайте NEXT_PUBLIC_API_URL при сборке:
#   NEXT_PUBLIC_API_URL=https://api.example.com docker compose --profile frontend build
#
# Яндекс.Карты (профиль мастера — точка отсчёта радиуса выезда). Кабинет разработчика:
# https://developer.tech.yandex.ru/services/ — JavaScript API и HTTP Геокодер.
# Для docker compose --profile frontend build задайте в .env; для локального dev — frontend/.env.local:
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Поиск адреса на карте мастера идёт через серверный прокси /api/yandex-geocode (HTTP Геокодер).
# В кабинете к ключу должны быть подключены «JavaScript API» и «HTTP Геокодер».
# Опционально отдельный ключ только для сервера (не светится в браузере):
# YANDEX_MAPS_SERVER_API_KEY=
#
# Если порт 3000 занят (например, локальный `npm run dev`), задайте другой порт и тот же URL для OAuth/писем:
# FRONTEND_PORT=3001
# FRONTEND_URL=http://localhost:3001
# Google Cloud Console → APIs & Credentials → OAuth 2.0 Client ID (тип «Веб-приложение»).
# Authorized JavaScript origins (пример локально): http://localhost:3000
# Authorized redirect URIs — ровно один URI на окружение, без хвоста /:
#   http://localhost:8080/api/v1/auth/google/callback
# (должен совпадать с BASE_URL из этого файла + путь; см. api-gateway internal/handler/oauth.go)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — VK ID
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# api-gateway: каталог для загруженных фото (локально по умолчанию ./data/uploads).
# UPLOAD_ROOT=./data/uploads

# venue-service: уведомления в Telegram о новых заявках на модерацию и смене статуса.
# TELEGRAM_BOT_TOKEN=...   # токен от @BotFather
# TELEGRAM_CHAT_ID=...      # число: личный чат или группа (часто отрицательный id для групп)
#
# Как узнать chat_id:
# 1) Личные сообщения: напишите боту любое сообщение, затем откройте в браузере
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    в ответе найдите "chat":{"id": 123456789, ...} — это TELEGRAM_CHAT_ID.
# 2) Группа: добавьте бота в группу, напишите в чат команду /start или упомяните бота,
#    снова вызовите getUpdates — id группы обычно отрицательный (например -1001234567890).
# Без токена и chat_id уведомления отключены (в логах venue-service будет предупреждение).

# api-gateway и auth-service: SMTP (все пять переменных ниже). api-gateway — письма при приостановке/возобновлении заведения; auth-service — ссылка сброса пароля (нужны FRONTEND_URL и миграция auth_db с password_reset_tokens).
# После правок в deploy/.env перезапустите контейнеры: docker compose up -d auth-service api-gateway
#
# Яндекс: SMTP_HOST=smtp.yandex.ru, порт 465 (TLS сразу) или 587 (STARTTLS). Пароль — «Пароль приложения», не обычный пароль аккаунта.
# Gmail: SMTP_HOST=smtp.gmail.com, порт 587, SMTP_USER/SMTP_FROM — ваш адрес, SMTP_PASSWORD — пароль приложения (Google Account → Security).
# Mail.ru: SMTP_HOST=smtp.mail.ru, порт 465 или 587.
#
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USER=your@yandex.ru
# SMTP_PASSWORD=app-password
# SMTP_FROM=your@yandex.ru
# Опционально: как шифровать канал (по умолчанию на 465 — implicit TLS, на остальных портах — STARTTLS если сервер поддерживает).
# SMTP_TLS=implicit   # принудительно SMTPS (часто для порта 465)
# SMTP_TLS=starttls   # принудительно STARTTLS (если порт не 465, но TLS обязателен)
# SMTP_TLS=off        # без TLS (только для локального SMTP вроде Mailpit на 1025)
#
# Срок ссылки сброса пароля в auth-service (опционально; в docker-compose по умолчанию 1h):
# PASSWORD_RESET_TTL=1h
#
# auth-service: дополнительная строка в логах при каждом запросе сброса (1/true/yes).
# PASSWORD_RESET_VERBOSE=1
#
# api-gateway: лимит POST /auth/forgot-password на один IP (память процесса; при нескольких репликах — свой Redis и т.п.).
# FORGOT_PASSWORD_RATE_LIMIT_MAX=10
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW=15m
# FORGOT_PASSWORD_RATE_LIMIT_MAX=0 отключает лимит.
#
# Миграции всех сервисов на уже запущенный postgres (контейнер banya-postgres): из корня репозитория
#   bash deploy/migrate.sh

# booking-service: IANA-зона для date + time_to (переход confirmed → completed после окончания слота).
# BOOKING_VISIT_TIMEZONE=Europe/Moscow

# === docker-compose.observability.yml (Grafana) ===
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
